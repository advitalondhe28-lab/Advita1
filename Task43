        "import cv2\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import os\n",
        "import glob\n",
        "\n",
        "image_files = glob.glob(\"/content/xray_data/**/*.png\", recursive=True) + \\\n",
        "              glob.glob(\"/content/xray_data/**/*.jpg\", recursive=True)\n",
        "print(f\"Found {len(image_files)} images\")\n",
        "\n",
        "image_path = image_files[0]\n",
        "print(\"Using:\", image_path)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "ZuhO0bakWVR6",
        "outputId": "fd7c81c0-6963-4549-f21a-f217a58a0bf0"
      },
      "execution_count": 9,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Found 11212 images\n",
            "Using: /content/xray_data/sample/images/00019710_000.png\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# -----------------------------\n",
        "# Load as grayscale\n",
        "# -----------------------------\n",
        "img = cv2.imread(image_path, cv2.IMREAD_GRAYSCALE)\n",
        "img = cv2.resize(img, (512, 512))\n",
        "\n",
        "# -----------------------------\n",
        "# Step 1: Contrast enhancement (helps thresholding find lung boundary)\n",
        "# -----------------------------\n",
        "clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8))\n",
        "enhanced = clahe.apply(img)\n",
        "\n",
        "# -----------------------------\n",
        "# Step 2: Thresholding — Otsu's method auto-picks the best threshold\n",
        "# -----------------------------\n",
        "_, thresh = cv2.threshold(enhanced, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)\n",
        "thresh_inv = cv2.bitwise_not(thresh)\n",
        "\n",
        "# -----------------------------\n",
        "# Step 3: Morphological cleanup\n",
        "# -----------------------------\n",
        "kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (9, 9))\n",
        "opened = cv2.morphologyEx(thresh_inv, cv2.MORPH_OPEN, kernel, iterations=2)\n",
        "closed = cv2.morphologyEx(opened, cv2.MORPH_CLOSE, kernel, iterations=3)\n",
        "\n",
        "# -----------------------------\n",
        "# Step 4: Keep only the largest connected regions (the two lungs)\n",
        "# -----------------------------\n",
        "contours, _ = cv2.findContours(closed, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n",
        "contours = sorted(contours, key=cv2.contourArea, reverse=True)[:2]\n",
        "\n",
        "lung_mask = np.zeros_like(closed)\n",
        "cv2.drawContours(lung_mask, contours, -1, 255, thickness=cv2.FILLED)\n",
        "\n",
        "# -----------------------------\n",
        "# Step 5: Apply mask to extract lung ROI\n",
        "# -----------------------------\n",
        "lung_roi = cv2.bitwise_and(img, img, mask=lung_mask)\n",
        "\n",
        "# -----------------------------\n",
        "# Display results\n",
        "# -----------------------------\n",
        "fig, axes = plt.subplots(2, 3, figsize=(15, 10))\n",
        "\n",
        "axes[0, 0].imshow(img, cmap=\"gray\")\n",
        "axes[0, 0].set_title(\"Original X-ray\")\n",
        "\n",
        "axes[0, 1].imshow(enhanced, cmap=\"gray\")\n",
        "axes[0, 1].set_title(\"Contrast Enhanced (CLAHE)\")\n",
        "\n",
        "axes[0, 2].imshow(thresh_inv, cmap=\"gray\")\n",
        "axes[0, 2].set_title(\"Thresholded (Otsu)\")\n",
        "\n",
        "axes[1, 0].imshow(closed, cmap=\"gray\")\n",
        "axes[1, 0].set_title(\"After Morphological Cleanup\")\n",
        "\n",
        "axes[1, 1].imshow(lung_mask, cmap=\"gray\")\n",
        "axes[1, 1].set_title(\"Final Lung Mask\")\n",
        "\n",
        "axes[1, 2].imshow(lung_roi, cmap=\"gray\")\n",
        "axes[1, 2].set_title(\"Extracted Lung ROI\")\n",
        "\n",
        "for ax in axes.flat:\n",
        "    ax.axis(\"off\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"lung_segmentation_result.png\", bbox_inches=\"tight\")\n",
        "plt.show()\n",
        "\n",
        "cv2.imwrite(\"lung_mask.png\", lung_mask)\n",
        "cv2.imwrite(\"lung_roi.png\", lung_roi)"
      ],
