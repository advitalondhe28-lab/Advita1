        "import cv2\n",
        "import numpy as np\n",
        "from segment_anything import sam_model_registry, SamAutomaticMaskGenerator\n",
        "from google.colab.patches import cv2_imshow  # Colab-safe display\n",
        "\n",
        "# -----------------------------\n",
        "# Load SAM\n",
        "# -----------------------------\n",
        "checkpoint = \"sam_vit_b_01ec64.pth\"\n",
        "sam = sam_model_registry[\"vit_b\"](checkpoint=checkpoint)\n",
        "\n",
        "import torch\n",
        "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
        "sam.to(device=device)\n",
        "print(\"Using device:\", device)\n",
        "\n",
        "mask_generator = SamAutomaticMaskGenerator(sam)\n",
        "\n",
        "# -----------------------------\n",
        "# Load image\n",
        "# -----------------------------\n",
        "image = cv2.imread(\"test.jpg\")\n",
        "if image is None:\n",
        "    raise FileNotFoundError(\"test.jpg not found — upload it first\")\n",
        "rgb = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)\n",
        "\n",
        "# -----------------------------\n",
        "# Generate masks\n",
        "# -----------------------------\n",
        "masks = mask_generator.generate(rgb)\n",
        "print(\"Masks detected:\", len(masks))\n",
        "\n",
        "# -----------------------------\n",
        "# Select largest mask\n",
        "# -----------------------------\n",
        "largest_mask = max(masks, key=lambda x: x[\"area\"])\n",
        "mask = largest_mask[\"segmentation\"]\n",
        "mask = (mask * 255).astype(np.uint8)\n",
        "\n",
        "# -----------------------------\n",
        "# Clean mask\n",
        "# -----------------------------\n",
        "kernel = np.ones((5, 5), np.uint8)\n",
        "mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, kernel)\n",
        "\n",
        "# -----------------------------\n",
        "# Create custom background\n",
        "# -----------------------------\n",
        "background = np.zeros_like(image)\n",
        "background[:] = (0, 255, 0)  # Green\n",
        "\n",
        "# -----------------------------\n",
        "# Combine foreground/background\n",
        "# -----------------------------\n",
        "foreground = cv2.bitwise_and(image, image, mask=mask)\n",
        "inverse_mask = cv2.bitwise_not(mask)\n",
        "background_part = cv2.bitwise_and(background, background, mask=inverse_mask)\n",
        "result = cv2.add(foreground, background_part)\n",
        "\n",
        "# -----------------------------\n",
        "# Display (Colab-safe)\n",
        "# -----------------------------\n",
        "print(\"Original:\")\n",
        "cv2_imshow(image)\n",
        "print(\"Background Removed:\")\n",
        "cv2_imshow(result)\n",
        "\n",
        "# Save result\n",
        "cv2.imwrite(\"background_removed.jpg\", result)"
